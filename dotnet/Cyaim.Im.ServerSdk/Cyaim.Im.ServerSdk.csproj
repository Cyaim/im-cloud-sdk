<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Cleared on purpose, and kept cleared. There is no Directory.Build.props above this tree
         today (SDK/ is a sibling of IM.Server/, whose props file does not reach here), but the
         service's props pinned a single TargetFramework when this project lived inside it, and a
         set TargetFramework silently wins over TargetFrameworks. Blanking it costs nothing and
         keeps the multi-targeting below true if a SDK/Directory.Build.props is ever added. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Cyaim.Im.ServerSdk</RootNamespace>
    <AssemblyName>Cyaim.Im.ServerSdk</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>Cyaim.Im.ServerSdk</PackageId>
    <Description>Server-side SDK for Cyaim IM Cloud. For tenant backends only — it holds the app secret and mints user tokens.</Description>
    <Authors>Cyaim Studio</Authors>
    <PackageTags>im;chat;messaging;sdk</PackageTags>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

    <!-- Without this line MSBuild picks 1.0.0, and it picked it silently: `dotnet pack -c Release`
         produced Cyaim.Im.ServerSdk.1.0.0.nupkg while Build-SdkCatalog.ps1, failing to find a
         <Version> here, fell back to the client SDKs' number and told every trial customer through
         GET /console/v1/sdks that the package was 0.9.0. Neither half complained. 1.0.0 is also the
         number CONTRACT.md §9.1 reserves for after a real integrator has lived on this SDK, and
         NuGet cannot delete a published version — only unlist it.
         The server SDK is versioned on its own (CONTRACT.md §9.1 puts the lockstep on the five
         *client* SDKs); it is pinned here, in its own manifest, because that is where both the
         catalogue generator and SdkVersionLockstepTests read it from. -->
    <Version>0.9.0</Version>

    <!-- sdk/** is Apache-2.0 (CONTRACT.md §9.2). The SPDX expression is what nuget.org renders as a
         structured licence; the text itself is packed by the <None Include="../LICENSE"> item below.
         Both are needed: Apache-2.0 §4(a) asks that a redistribution carry a copy of the licence, and
         the expression alone packs none — measured: the 0.9.0 .nupkg of 2026-09-14 held 3 dlls,
         3 xml files and README.md, and no LICENSE. PackageLicenseFile is not the way to add it: it and
         PackageLicenseExpression are mutually exclusive (NU5033), so the text rides as a plain packed
         item. dotnet/LICENSE is a byte-for-byte copy of SDK/LICENSE; SdkPublishedMetadataTests in
         im-cloud fails if any per-package copy drifts from the root one. -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Cyaim Studio</Copyright>

    <!-- The SDKs moved to their own public repository on 2026-08-31. These two were absent rather
         than wrong, which on nuget.org means the "Project website" and "Source repository" links do
         not render at all: someone holding the package has no way back to the source. RepositoryUrl
         is written out rather than derived with PublishRepositoryUrl, which reads the git remote and
         so reports whatever fork the build happened to run in. -->
    <PackageProjectUrl>https://github.com/Cyaim/im-cloud-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Cyaim/im-cloud-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Needs the <None> item below as well: this property alone fails the pack with NU5039. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The README is one directory up, shared with anyone reading the repository; pack it into the
         package root so nuget.org has a front page. Pack="true" is the half that actually copies it.
         打包根目录，PackagePath 必须与 PackageReadmeFile 的文件名一致。 -->
    <None Include="../README.md" Pack="true" PackagePath="\" />
    <!-- The licence text, at the package root. NuGet reads an extensionless PackagePath as a folder,
         so the path is empty and the file keeps its own name, LICENSE. -->
    <None Include="../LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
